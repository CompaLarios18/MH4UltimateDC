+    // mh4n (patch 11): Vulkan allows one aspect per region of a buffer <-> image copy. A copy of a depth-stencil
+    // image therefore becomes two regions: the depth plane at the footprint's offset (4 bytes per texel, for
+    // both D32 and D24: D24 sits in the low 24 bits), then the stencil plane (1 byte per texel) right after it.
+    // Returns the number of regions written to out (1 or 2).
+    static uint32_t splitDepthStencilCopy(const VkBufferImageCopy &copy, VkBufferImageCopy *out) {
+        const VkImageAspectFlags depthStencil = VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
+        out[0] = copy;
+        if (copy.imageSubresource.aspectMask != depthStencil) {
+            return 1;
+        }
+
+        out[0].imageSubresource.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+        out[1] = copy;
+        out[1].imageSubresource.aspectMask = VK_IMAGE_ASPECT_STENCIL_BIT;
+        out[1].bufferOffset += uint64_t(copy.bufferRowLength) * uint64_t(copy.bufferImageHeight) * uint64_t(copy.imageExtent.depth) * 4;
