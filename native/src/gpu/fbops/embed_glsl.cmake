# Writes a C++ source file that holds a GLSL file as a raw string (run with cmake -P).
#   -DINPUT=<file.glsl> -DOUTPUT=<file.cpp>
# The text is returned by mh4n::gpu::fbops::OutputStageGlsl() exactly as the file has it, so the text the product embeds
# is the text of the committed source and, through the test shaders that #include it, of the committed test SPIR-V.
if (NOT INPUT OR NOT OUTPUT)
    message(FATAL_ERROR "embed_glsl.cmake: INPUT and OUTPUT are required")
endif()
get_filename_component(input_name "${INPUT}" NAME)
file(READ "${INPUT}" text)
if (text MATCHES "\\)MH4NGLSL\"")
    message(FATAL_ERROR "embed_glsl.cmake: ${input_name} contains the raw string's terminator")
endif()
file(WRITE "${OUTPUT}.tmp"
"// Generated by embed_glsl.cmake from ${input_name}. Do not edit.
#include \"gpu/fbops/output_stage.h\"

namespace mh4n::gpu::fbops {

std::string_view OutputStageGlsl() {
    static constexpr char kText[] = R\"MH4NGLSL(${text})MH4NGLSL\";
    return std::string_view(kText, sizeof(kText) - 1);
}

}  // namespace mh4n::gpu::fbops
")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
