+int FramebufferLayout::BottomViewAt(unsigned framebuffer_x, unsigned framebuffer_y) const {
+    if (!bottom_screen_enabled) {
+        return -1;
+    }
+    const auto count = std::min<std::size_t>(bottom_view_count, bottom_views.size());
+    for (int i = static_cast<int>(count) - 1; i >= 0; --i) {
+        const auto& r = bottom_views[i].screen;
+        if (framebuffer_x >= r.left && framebuffer_x < r.right && framebuffer_y >= r.top &&
+            framebuffer_y < r.bottom) {
+            return i;
+        }
+    }
+    return -1;
+}
