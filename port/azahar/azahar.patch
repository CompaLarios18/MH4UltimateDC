+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+#pragma once
+
+#include <array>
+#include <cstddef>
+
+#include "common/common_types.h"
+
+namespace Layout {
+
+/// The width the screen layouts give the top screen at its 240-pixel height: 400, as on a
+/// 3DS, unless a port that shows the top screen wider sets another (427 for 16:9, say).
+u32 TopScreenWidth();
+void SetTopScreenWidth(u32 width);
+
+/// The custom layout as a port can set it up instead of fixed positions: the main screen
+/// fills the window at its aspect ratio and the other one is drawn over it in a corner,
+/// `height` times the window's height (0: off, the custom layout's own positions apply).
+/// When the bottom screen is the one in the corner, it can show just a part of it: the crop
+/// rectangle, in fractions of the bottom screen's width and height (touches map to that part).
+struct ScreenOverlay {
+    enum class Corner : u8 { TopLeft, TopRight, BottomLeft, BottomRight };
+    float height = 0.0f;
+    float opacity = 1.0f;
+    Corner corner = Corner::BottomRight;
+    float crop_left = 0.0f, crop_top = 0.0f, crop_right = 1.0f, crop_bottom = 1.0f;
+    /// A place in the window instead of the corner, when both are 0..1 (negative: the corner):
+    /// where the overlay's left and top edges go in the room the window leaves beside and above
+    /// it, 0 at the window's left (top) edge, 1 with its right (bottom) edge at the window's. So
+    /// it stays in the window at any size; (1, 0) is the top-right corner.
+    float x = -1.0f, y = -1.0f;
+
+    /// Further parts of the bottom screen drawn on their own over the main screen, at the same
+    /// opacity (the port's quest HUD: the target camera panel beside the map). Only while the
+    /// bottom screen is the one in the corner, in landscape orientation. A touch on one maps to
+    /// its part of the bottom screen.
+    struct View {
+        float height = 0.0f; ///< times the window's height; 0: off
+        float x = 1.0f, y = 0.0f; ///< as ScreenOverlay::x, y (0..1)
+        float crop_left = 0.0f, crop_top = 0.0f, crop_right = 1.0f, crop_bottom = 1.0f;
+    };
+    static constexpr std::size_t MAX_VIEWS = 2;
+    std::array<View, MAX_VIEWS> views{};
+};
+ScreenOverlay GetScreenOverlay();
+void SetScreenOverlay(const ScreenOverlay& overlay);
+
+} // namespace Layout
