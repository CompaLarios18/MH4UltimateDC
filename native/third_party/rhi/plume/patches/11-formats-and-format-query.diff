+    RenderFormatSupport VulkanDevice::getFormatSupport(RenderFormat format) const {
+        RenderFormatSupport support;
+        if ((format == RenderFormat::UNKNOWN) || (format >= RenderFormat::MAX)) {
+            return support;
+        }
+
+        const VkFormat vkFormat = toVk(format);
+        if (vkFormat == VK_FORMAT_UNDEFINED) {
+            return support;
+        }
+
+        VkFormatProperties properties = {};
+        vkGetPhysicalDeviceFormatProperties(physicalDevice, vkFormat, &properties);
+        const VkFormatFeatureFlags features = properties.optimalTilingFeatures;
+        const VkFormatFeatureFlags attachmentFeature = RenderFormatIsDepth(format) ? VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT : VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+        support.attachment = (features & attachmentFeature) != 0;
+        support.sampled = (features & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT) != 0;
+        support.storage = (features & VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT) != 0;
+        support.blitSource = (features & VK_FORMAT_FEATURE_BLIT_SRC_BIT) != 0;
+        support.blitDestination = (features & VK_FORMAT_FEATURE_BLIT_DST_BIT) != 0;
+        return support;
+    }
