+Common::Rectangle<float> CropLandscapeTexcoords(const Common::Rectangle<float>& texcoords,
+                                                const Common::Rectangle<float>& crop) {
+    // landscape drawing: the screen's x runs left -> right, its y runs bottom -> top
+    const float u = texcoords.right - texcoords.left;
+    const float v = texcoords.top - texcoords.bottom;
+    Common::Rectangle<float> res;
+    res.left = texcoords.left + u * crop.left;
+    res.right = texcoords.left + u * crop.right;
+    res.bottom = texcoords.bottom + v * crop.top;
+    res.top = texcoords.bottom + v * crop.bottom;
+    return res;
+}
