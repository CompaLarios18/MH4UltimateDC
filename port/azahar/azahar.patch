@@ -6,11 +6,65 @@
 #include <boost/algorithm/string/replace.hpp>
 #include <boost/uuid/uuid_generators.hpp>
 #include <boost/uuid/uuid_io.hpp>
+#include <condition_variable>
+#include <deque>
+#include <exception>
+#include <memory>
+#include <mutex>
+#include <thread>
 #include "common/android_utils.h"
 #include "common/file_util.h"
 #include "common/logging/log.h"
 
 namespace AndroidUtils {
+namespace {
+// Primed by InitJNI() (JNI_OnLoad) and CacheUserDirectory() (directory init). Reading
+// these from the emulation core avoids ART/JNI calls from the port's fiber stack.
+std::string g_cached_build_flavor;
+std::string g_cached_user_directory;
+
+// The JNI executor: applet callbacks run here instead of on the emulation fiber.
+struct JniTask {
+    std::function<void()> fn;
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool done = false;
+    std::exception_ptr error;
+};
+
+std::thread g_jni_thread;
+std::thread::id g_jni_thread_id;
+std::mutex g_jni_mutex;
+std::condition_variable g_jni_cv;
+std::deque<std::shared_ptr<JniTask>> g_jni_tasks;
+bool g_jni_stopping = false;
+
+void JniThreadMain() {
+    for (;;) {
+        std::shared_ptr<JniTask> task;
+        {
+            std::unique_lock lock(g_jni_mutex);
+            g_jni_cv.wait(lock, [] { return g_jni_stopping || !g_jni_tasks.empty(); });
+            if (g_jni_tasks.empty()) {
+                break;
+            }
+            task = std::move(g_jni_tasks.front());
+            g_jni_tasks.pop_front();
+        }
+        try {
+            task->fn();
+        } catch (...) {
+            task->error = std::current_exception();
+        }
+        {
