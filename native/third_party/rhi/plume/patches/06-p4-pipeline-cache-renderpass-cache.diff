+    VkRenderPass VulkanDevice::getRenderPass(const VkFormat *renderTargetFormat, uint32_t renderTargetCount, VkFormat depthTargetFormat, VkSampleCountFlagBits sampleCount) {
+        std::string key(reinterpret_cast<const char *>(renderTargetFormat), renderTargetCount * sizeof(VkFormat));
+        key.append(reinterpret_cast<const char *>(&depthTargetFormat), sizeof(depthTargetFormat));
+        key.append(reinterpret_cast<const char *>(&sampleCount), sizeof(sampleCount));
+        const std::scoped_lock lock(renderPassMutex);
+        auto it = renderPassCache.find(key);
+        if (it != renderPassCache.end()) {
+            return it->second;
+        }
+
+        VkRenderPass renderPass = VulkanGraphicsPipeline::createRenderPass(this, renderTargetFormat, renderTargetCount, depthTargetFormat, sampleCount);
+        if (renderPass != VK_NULL_HANDLE) {
+            renderPassCache[key] = renderPass;
+        }
+
+        return renderPass;
+    }
+
+    bool VulkanDevice::loadPipelineCache(const void *data, size_t size) {
+        VkPipelineCacheCreateInfo cacheInfo = {};
+        cacheInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+        cacheInfo.initialDataSize = size;
+        cacheInfo.pInitialData = data;
+        VkPipelineCache cache = VK_NULL_HANDLE;
+        if (vkCreatePipelineCache(vk, &cacheInfo, nullptr, &cache) != VK_SUCCESS) {
+            return false;
+        }
+
+        if (pipelineCache != VK_NULL_HANDLE) {
+            vkDestroyPipelineCache(vk, pipelineCache, nullptr);
+        }
+
+        pipelineCache = cache;
+        return true;
+    }
+
+    bool VulkanDevice::savePipelineCache(std::vector<uint8_t> &out) {
+        size_t size = 0;
+        if (vkGetPipelineCacheData(vk, pipelineCache, &size, nullptr) != VK_SUCCESS) {
+            return false;
+        }
+
+        out.resize(size);
+        return vkGetPipelineCacheData(vk, pipelineCache, &size, out.data()) == VK_SUCCESS;
+    }
+
