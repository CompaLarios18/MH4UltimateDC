# Writes a C++ source file that holds a binary file as a byte array (run with cmake -P).
#   -DINPUT=<file> -DOUTPUT=<file.cpp> -DSYMBOL=<name>
# The array is `extern const unsigned char SYMBOL[]` and its size `extern const unsigned long long
# SYMBOL_size` in namespace mh4n::fs::embedded. Used for the open-source system archives
# (native/third_party/open_source_archives), at build time, so no generated source is kept in the repository.
if (NOT INPUT OR NOT OUTPUT OR NOT SYMBOL)
    message(FATAL_ERROR "embed_archive.cmake: INPUT, OUTPUT and SYMBOL are required")
endif()
get_filename_component(input_name "${INPUT}" NAME)
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
# 32 bytes (64 hex digits) a line keeps the lines short.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}.tmp"
"// Generated by embed_archive.cmake from ${input_name}. Do not edit.
namespace mh4n::fs::embedded {
extern const unsigned char ${SYMBOL}[] = {
${bytes}
};
extern const unsigned long long ${SYMBOL}_size = ${size}ull;
}  // namespace mh4n::fs::embedded
")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
