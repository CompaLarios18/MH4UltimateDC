@@ -0,0 +1,47 @@
+// Copyright 2026 Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the misc/licenses/gplv2.txt file included.
+
+// MH4U port: a frontend's own drawing over the screens, e.g. the port's app's in-game menu
+// (Dear ImGui). Nothing is drawn unless a frontend registers an overlay.
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#ifndef VK_NO_PROTOTYPES
+#define VK_NO_PROTOTYPES
+#endif
+#include <vulkan/vulkan_core.h>
+
+namespace Vulkan {
+
+struct PresentOverlay {
+    /// What a drawing library needs of the renderer.
+    struct Context {
+        PFN_vkGetInstanceProcAddr get_instance_proc_addr;
+        VkInstance instance;
+        VkPhysicalDevice physical_device;
+        VkDevice device;
+        std::uint32_t api_version;
+        std::uint32_t queue_family;
+        VkQueue queue;
+        std::mutex* queue_mutex;   ///< held by whoever submits to `queue`
+        VkRenderPass render_pass;  ///< the main window's present render pass (subpass 0)
+        std::uint32_t image_count; ///< frames in flight
+    };
+    using Commands = std::function<void(VkCommandBuffer)>;
+
+    /// Called once a frame on the emulation thread while the main window's present render pass
+    /// is being recorded, `width` x `height` pixels: the commands it returns are recorded in
+    /// that render pass after the screens, on the scheduler's thread. Empty: nothing this frame.
+    std::function<Commands(const Context&, std::uint32_t width, std::uint32_t height)> draw;
+    /// The renderer is going away and its device is idle: release what `draw` made.
+    std::function<void()> release;
+};
+
+/// Registers the overlay (an empty one removes it).
+void SetPresentOverlay(PresentOverlay overlay);
+
+} // namespace Vulkan
