+void SetScreenOverlay(const ScreenOverlay& overlay) {
+    std::scoped_lock lock{overlay_mutex};
+    screen_overlay = overlay;
+    screen_overlay.height = std::clamp(overlay.height, 0.0f, 1.0f);
+    screen_overlay.opacity = std::clamp(overlay.opacity, 0.0f, 1.0f);
+    // a crop of at least 1% each way, inside the screen
+    screen_overlay.crop_left = std::clamp(overlay.crop_left, 0.0f, 0.99f);
+    screen_overlay.crop_top = std::clamp(overlay.crop_top, 0.0f, 0.99f);
+    screen_overlay.crop_right = std::clamp(overlay.crop_right, screen_overlay.crop_left + 0.01f, 1.0f);
+    screen_overlay.crop_bottom = std::clamp(overlay.crop_bottom, screen_overlay.crop_top + 0.01f, 1.0f);
+    for (auto& view : screen_overlay.views) {
+        view.height = std::clamp(view.height, 0.0f, 1.0f);
+        view.x = std::clamp(view.x, 0.0f, 1.0f);
+        view.y = std::clamp(view.y, 0.0f, 1.0f);
+        view.crop_left = std::clamp(view.crop_left, 0.0f, 0.99f);
+        view.crop_top = std::clamp(view.crop_top, 0.0f, 0.99f);
+        view.crop_right = std::clamp(view.crop_right, view.crop_left + 0.01f, 1.0f);
+        view.crop_bottom = std::clamp(view.crop_bottom, view.crop_top + 0.01f, 1.0f);
+    }
