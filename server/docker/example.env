# Settings for compose.yaml: copy this to .env next to it and fill it in. .env holds the room's
# token and password: keep it out of git.

# The address players reach this server at (its public IP or a host name)
PUBLIC_ADDRESS=

# open: a name belongs to whoever signs in with it first; invite: only names you add
LOBBY_MODE=open
LOBBY_PORT=24872

ROOM_NAME=MH4U Gathering Hall
ROOM_DESCRIPTION=
ROOM_PORT=24872
ROOM_PASSWORD=
ROOM_MAX_MEMBERS=16

# The room's own name and token in the lobby, to be listed there. Open mode: the first use
# claims the name, so pick any token (a long random one). Invite mode: first run
#   docker compose exec lobby mh4u-lobby add-user "MH4U Room"
# and put the token it prints here, then: docker compose up -d room
LOBBY_USERNAME=MH4U Room
LOBBY_TOKEN=
